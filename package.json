{
  "name": "swifty-code",
  "version": "0.0.1",
  "type": "module",
  "description": "swifty-code",
  "private": true,
  "scripts": {
    "git:commit": "git add -A && git commit -m \"feat: Introduce new features\"",
    "git:commit:skip": "git add -A && git commit -m \"feat: Introduce new features [skip ci]\"",
    "git:push": "pnpm git:commit && git push origin main",
    "git:push:skip": "pnpm git:commit:skip && git push origin main",
    "format:sh": "shfmt -w ./install.sh",
    "format": "pnpm --filter @swifty.js/swifty format",
    "build": "pnpm --filter @swifty.js/swifty build",
    "prepare": "husky"
  },
  "keywords": [
    "swifty",
    "code"
  ],
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1"
  },
  "lint-staged": {
    "apps/swifty/**/*.{json,jsonc,js,cjs,mjs,jsx,ts,cts,mts,tsx,html,vue,css,scss,md,mdx}": [
      "pnpm --filter @swifty.js/swifty format"
    ]
  },
  "author": "https://github.com/hangtiancheng",
  "license": "MIT",
  "packageManager": "pnpm@10.33.1",
  "pnpm": {
    "overrides": {
      "@swifty.js/swifty": "workspace:*"
    }
  }
}
